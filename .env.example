# Existing `tg=...` is also supported. Never commit your real .env.
TELEGRAM_BOT_TOKEN=
# Optional: skips the getMe lookup on the login page (without @).
TELEGRAM_BOT_USERNAME=
PUBLIC_URL=http://localhost:8000
COOKIE_SECURE=false
# Production URL and secure cookies are set by compose.traefik.yaml.
DATABASE_URL=sqlite:////data/ebay.db
# Optional. A random persistent key is generated in /data if omitted.
SECRET_KEY=
# A fresh delay of 10-20 seconds is sampled after each page request.
REQUEST_DELAY_SECONDS=10
REQUEST_DELAY_JITTER_SECONDS=10
EBAY_HTTP_CLIENT=playwright
# Only used by the curl_cffi alternative:
EBAY_BROWSER=chrome
EBAY_BLOCK_COOLDOWN_SECONDS=900
# Compose sets the persistent browser profile to /browser-profile.
# false uses a normal browser with an automatically started private Xvfb display in Docker.
EBAY_BROWSER_HEADLESS=false
EBAY_FIREFOX_FALLBACK=true
EBAY_BROWSER_TIMEOUT_SECONDS=45
# Each check reads only the first results page. Item pages are never fetched.
# Optional standard HTTP proxy; no CAPTCHA bypass is performed.
EBAY_PROXY=

